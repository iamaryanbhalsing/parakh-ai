# Parakh (परख) AI — LLM / AI-agent configuration
# Copy to .env and fill in. Without a key, the NLP rules engine is used.

# OpenAI-compatible endpoint (OpenAI, Groq, DeepSeek, OpenRouter, or local Ollama: http://localhost:11434/v1)
PARAKH_LLM_BASE_URL=https://api.openai.com/v1

# API key for the model provider (never commit the real value)
PARAKH_LLM_API_KEY=

# Model to use for call analysis
PARAKH_LLM_MODEL=gpt-4o-mini

# Seconds to wait for a model response before falling back to NLP
PARAKH_LLM_TIMEOUT=15
